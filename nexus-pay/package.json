{
  "name": "nexus-pay",
  "version": "1.0.0",
  "private": true,
  "description": "Nexus Pay - consumer digital wallet and personal payments platform",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @nexus/web dev",
    "build": "pnpm --filter @nexus/web build",
    "start": "pnpm --filter @nexus/web start",
    "lint": "pnpm --filter @nexus/web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit packages/shared-types/tests packages/api-client/tests packages/validation/tests",
    "test:integration": "cross-env RUN_INTEGRATION=1 RUN_RAFTLINE_INTEGRATION=1 vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @nexus/database db:generate",
    "db:migrate": "pnpm --filter @nexus/database db:migrate",
    "db:deploy": "pnpm --filter @nexus/database db:deploy",
    "db:studio": "pnpm --filter @nexus/database db:studio",
    "db:reset": "pnpm --filter @nexus/database db:reset",
    "setup": "pnpm install && pnpm db:generate && pnpm db:migrate"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.1",
    "cross-env": "10.1.0",
    "dotenv": "17.2.3",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
