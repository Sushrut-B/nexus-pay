# ---------------------------------------------------------------------------
# Nexus Pay - environment configuration
# Copy this file to apps/web/.env.local and replace every placeholder value.
# Also place DATABASE_URL in packages/database/.env for Prisma CLI commands.
# Never commit either file or any real secret.
# ---------------------------------------------------------------------------

# PostgreSQL. The bundled docker-compose exposes PostgreSQL on host port 5433
# to avoid colliding with a local PostgreSQL instance on 5432.
DATABASE_URL="postgresql://nexuspay:nexuspay@localhost:5433/nexus_pay?schema=public"

# 32+ byte random secret used to HMAC session tokens and password-reset tokens.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Public origin of the web application.
APP_URL="http://localhost:3000"

NODE_ENV="development"

# Raftline five-node cluster (HTTP/REST ports). Alternatively, provide a
# comma-separated list in RAFTLINE_BASE_URLS.
RAFTLINE_NODE_1_URL="http://localhost:8001"
RAFTLINE_NODE_2_URL="http://localhost:8002"
RAFTLINE_NODE_3_URL="http://localhost:8003"
RAFTLINE_NODE_4_URL="http://localhost:8004"
RAFTLINE_NODE_5_URL="http://localhost:8005"

# Logical namespace inside Raftline. Nexus Pay accounts live under
# pay:acc:<tenant>:<accountId> inside the replicated store.
RAFTLINE_TENANT_ID="nexuspay"

# Optional API key sent as X-API-Key when Raftline authentication is enabled.
RAFTLINE_API_KEY=""

# Total request budget for one Raftline HTTP call.
RAFTLINE_TIMEOUT_MS="5000"

# How long a discovered leader is trusted before the adapter re-checks.
RAFTLINE_LEADER_CACHE_TTL_MS="2000"

# auto     = use the payment account API, verify the write, then fall back to
#            the generic KV compatibility path when Raftline silently drops it.
# official = payment account API only (may silently no-op on affected builds).
# kv       = write the verified PaymentAccount record through the generic KV API.
RAFTLINE_ACCOUNT_CREATE_MODE="auto"

# Session lifetimes.
SESSION_TTL_HOURS="24"
SESSION_REMEMBER_ME_DAYS="30"

# Password recovery.
PASSWORD_RESET_TOKEN_TTL_MINUTES="30"
# Development only: return the reset link in the API response for local testing.
# This must be false in production.
PASSWORD_RESET_DEV_MODE="true"

# Optional SMTP delivery (Mailpit is exposed by docker-compose on 1025).
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Nexus Pay <no-reply@nexuspay.local>"

# Release 5 - Nexus Control
# Bootstrap super admin (development only; remove in production after first login)
ADMIN_BOOTSTRAP_EMAIL="
ADMIN_BOOTSTRAP_USERNAME="
ADMIN_BOOTSTRAP_PASSWORD="
NEXUS_CONTROL_ENABLED="true"
# Chaos engineering is disabled by default. Enable only for an isolated development cluster.
NEXUS_CONTROL_CHAOS_ENABLED="false"
NEXUS_CONTROL_ALLOW_QUORUM_LOSS="false"
NEXUS_CONTROL_POLL_INTERVAL_MS="30000"
NEXUS_CONTROL_ADMIN_SESSION_HOURS="8"

# Release 10 - external account aggregation
# Optional dedicated AES key (32+ chars); derived from AUTH_SECRET when omitted.
TOKEN_ENCRYPTION_KEY="
# Sandbox test provider only. Never enable in a production deployment with real data.
NEXUS_EXTERNAL_SANDBOX_ENABLED="false"


# Release 11 - credit marketplace sandbox fixtures only
NEXUS_CREDIT_SANDBOX_ENABLED="false"

# Release 12 - insurance marketplace sandbox fixtures only.
# No real insurer/broker/aggregator integration exists. Never enable in production.
NEXUS_INSURANCE_SANDBOX_ENABLED="false"

# Release 13 - fraud intelligence. Risk scores are indicators, not proof of fraud.
# The gateway is read-only: it never mutates wallets, payment intents or Raftline.
NEXUS_FRAUD_ENGINE_ENABLED="true"
NEXUS_FRAUD_GATEWAY_ENABLED="true"
# Explicit policy applied when the engine is unavailable or disabled.
NEXUS_FRAUD_FALLBACK_ACTION="REQUIRE_CUSTOMER_CONFIRMATION"
NEXUS_FRAUD_RETENTION_DAYS="365"

# Release 14 - bill payments & recharges.
# No real biller/BBPS/Bharat Connect participation exists. Sandbox fixtures only.
NEXUS_BILLING_SANDBOX_ENABLED="false"
NEXUS_BILLING_REMINDER_DAYS="7"

# Release 15 - travel & mobility. Sandbox fixtures only; no real provider or
# IRCTC/airline/hotel/bus/metro partnership exists.
NEXUS_TRAVEL_SANDBOX_ENABLED="false"
NEXUS_TRAVEL_SEARCH_TTL_MINUTES="30"

# Release 16 - investments & wealth (read-only, informational; no trading)
# No SEBI/AMFI/Account Aggregator authorization exists. Sandbox fixtures only.
NEXUS_INVESTMENTS_SANDBOX_ENABLED="false"
NEXUS_INVESTMENTS_STALE_HOURS="48"

# Release 17 - tax centre (estimates only; no filing/government integration)
NEXUS_TAX_ENABLED="true"
NEXUS_TAX_DEFAULT_FINANCIAL_YEAR="2025-26"

# Release 18 - global finance. INR remains the only transactable wallet currency.
# All provider capabilities are OFF by default. Sandbox rates are deterministic
# REFERENCE test fixtures, never executable quotes. No remittance authorization
# or FX dealing licence is held by Nexus Pay.
NEXUS_GLOBAL_ENABLED="true"
NEXUS_GLOBAL_FX_SANDBOX_ENABLED="false"
NEXUS_GLOBAL_PAYMENTS_SANDBOX_ENABLED="false"
NEXUS_GLOBAL_RATE_STALE_HOURS="24"
NEXUS_GLOBAL_DEFAULT_DISPLAY_CURRENCY="INR"

# Release 19 - customer support & resolution centre (case management only).
# Support never changes payment, refund, cancellation or provider status.
NEXUS_SUPPORT_ENABLED="true"
NEXUS_SUPPORT_ATTACHMENT_MAX_BYTES="5242880"
NEXUS_SUPPORT_INACTIVITY_REMINDER_HOURS="48"
NEXUS_SUPPORT_HELP_REVIEW_DAYS="90"

# Release 20 - account security, privacy & identity protection.
# TOTP uses otplib (RFC 6238). Passkeys/WebAuthn are not implemented.
NEXUS_SECURITY_ENABLED="true"
NEXUS_SECURITY_MFA_ENABLED="false"
NEXUS_SECURITY_MFA_CHALLENGE_TTL_MINUTES="5"
NEXUS_SECURITY_STEP_UP_TTL_MINUTES="10"
NEXUS_SECURITY_RECOVERY_TTL_MINUTES="30"
NEXUS_SECURITY_EXPORT_TTL_HOURS="24"

