  @@index([householdId, createdAt])
  @@map("household_bill_assignments")
}

model BillProviderWebhook {
  id             String           @id @default(cuid())
  providerId     String
  eventType      String           @db.VarChar(80)
  eventId        String           @db.VarChar(180)
  payload        Json             @default("{}")
  signatureValid Boolean          @default(false)
  status         BillWebhookStatus @default(RECEIVED)
  error          String?          @db.VarChar(500)
  processedAt    DateTime?
  createdAt      DateTime         @default(now())
  provider BillPaymentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  @@unique([providerId, eventId])
  @@map("bill_provider_webhooks")
}

model BillProviderSync {
  id            String       @id @default(cuid())
  providerId    String
  kind          String       @db.VarChar(60)
  status        BillSyncStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime?
  leaseUntil    DateTime?
  error         String?      @db.VarChar(500)
  createdAt     DateTime     @default(now())
  provider BillPaymentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  @@index([status, nextAttemptAt])
  @@map("bill_provider_syncs")
}

model BillPaymentActivity {
