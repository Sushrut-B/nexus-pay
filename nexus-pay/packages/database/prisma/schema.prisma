  status      String               @db.VarChar(30) @default("UNAVAILABLE")
  capabilities Json
  config      Json?
  lastSyncAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  capabilityRows InvestmentProviderCapability[]
  connections    InvestmentConnection[]
  syncJobs       InvestmentSyncJob[]

  @@map("investment_providers")
}

model InvestmentProviderCapability {
  id         String  @id @default(cuid())
  providerId String
  capability String  @db.VarChar(60)
  enabled    Boolean @default(false)

  provider InvestmentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, capability])
