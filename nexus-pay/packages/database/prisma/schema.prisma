generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum WalletStatus {
  PENDING
  PROVISIONING
  ACTIVE
  FAILED
  RECONCILIATION_REQUIRED
}

enum WalletType {
  CUSTOMER
}

enum PaymentIntentStatus {
  CREATED
  PROCESSING
  SETTLED
  REJECTED
  UNKNOWN
  RECONCILIATION_REQUIRED
}

enum FundingOperationStatus {
  CREATED
  PROCESSING
  COMPLETED
  FAILED
  UNKNOWN
  RECONCILIATION_REQUIRED
}

enum TransactionKind {
  P2P
  FUNDING
}

enum TransactionDirection {
  SENT
  RECEIVED
}

enum TransactionStatus {
  PROCESSING
  SUCCESSFUL
  FAILED
  RECONCILIATION_REQUIRED
}

model User {
  id                    String        @id @default(cuid())
  fullName              String        @db.VarChar(120)
  email                 String        @unique @db.VarChar(254)
  phoneNumber           String        @unique @db.VarChar(20)
  passwordHash          String
  username              String        @unique @db.VarChar(30)
  isEmailVerified       Boolean       @default(false)
  isPhoneVerified       Boolean       @default(false)
  accountStatus         AccountStatus @default(ACTIVE)
  emailVerifiedAt       DateTime?
  phoneVerifiedAt       DateTime?
  lastLoginAt           DateTime?
  onboardingCompletedAt DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  profile                UserProfile?
  sessions               UserSession[]
  wallets                Wallet[]
  passwordResetTokens    PasswordResetToken[]
  auditEvents            AuditEvent[]         @relation("ActorAuditEvents")
  paymentIntentsSent     PaymentIntent[]      @relation("PaymentIntentSender")
  paymentIntentsReceived PaymentIntent[]      @relation("PaymentIntentRecipient")
  fundingOperations      FundingOperation[]
  transactionRecords     TransactionRecord[]

  // Release 3 social features
  contactsOwned       Contact[]         @relation("ContactOwner")
  contactsOf          Contact[]         @relation("ContactUser")
  requestsSent        PaymentRequest[]  @relation("RequestRequester")
  requestsReceived    PaymentRequest[]  @relation("RequestPayer")
  groupsCreated       ExpenseGroup[]    @relation("GroupCreator")
  groupMemberships    GroupMember[]
  expensesPaid        Expense[]         @relation("ExpensePayer")
  expensesCreated     Expense[]         @relation("ExpenseCreator")
  expenseSplits       ExpenseSplit[]
  settlementsPaid     GroupSettlement[] @relation("SettlementPayer")
  settlementsReceived GroupSettlement[] @relation("SettlementPayee")
  activities          GroupActivity[]
  notifications       Notification[]

  @@index([accountStatus])
  @@index([createdAt])
  @@map("users")
}

model UserProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  displayName       String   @db.VarChar(60)
  avatarUrl         String?  @db.VarChar(2048)
  preferredCurrency String   @default("INR") @db.VarChar(3)
  preferredLanguage String   @default("en-IN") @db.VarChar(10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  sessionTokenHash String    @unique @db.VarChar(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  ipAddress        String?   @db.VarChar(64)
  userAgent        String?   @db.VarChar(512)
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Wallet {
  id                    String       @id @default(cuid())
  userId                String
  raftlineAccountId     String?      @unique @db.VarChar(80)
  currency              String       @default("INR") @db.VarChar(3)
  walletType            WalletType   @default(CUSTOMER)
  status                WalletStatus @default(PENDING)
  provisioningAttempts  Int          @default(0)
  lastProvisioningError String?      @db.Text
  provisionedAt         DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentIntents    PaymentIntent[]
  fundingOperations FundingOperation[]
  transactions      TransactionRecord[]

  @@unique([userId, currency])
  @@index([status])
  @@map("wallets")
}

/// Durable intent for one P2P payment. A client request id is the customer-facing
/// idempotency boundary; the ledger idempotency key is generated once and never
/// replaced, even after a timeout or ambiguous outcome.
model PaymentIntent {
  id                   String              @id @default(cuid())
  userId               String
  walletId             String
  recipientUserId      String?
  clientRequestId      String              @db.VarChar(64)
  idempotencyKey       String              @unique @db.VarChar(80)
  status               PaymentIntentStatus @default(CREATED)
  recipientUsername    String              @db.VarChar(30)
  recipientDisplayName String              @db.VarChar(60)
  sourceAccountId      String              @db.VarChar(80)
  destinationAccountId String              @db.VarChar(80)
  amountMinor          BigInt
  currency             String              @db.VarChar(3)
  description          String?             @db.VarChar(140)
  paymentRef           String?             @unique @db.VarChar(80)
  raftLogIndex         BigInt?
  rejectionCode        String?             @db.VarChar(80)
  failureMessage       String?             @db.VarChar(500)
  attemptCount         Int                 @default(0)
  lastAttemptAt        DateTime?
  lastReconciledAt     DateTime?
  receiptVerifiedAt    DateTime?
  lastWasIdempotentReplay Boolean          @default(false)
  settledAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user        User               @relation("PaymentIntentSender", fields: [userId], references: [id], onDelete: Cascade)
  recipient   User?              @relation("PaymentIntentRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  wallet      Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transaction TransactionRecord?

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([status, lastAttemptAt])
  @@map("payment_intents")
}

/// Durable record of one simulated INR sandbox funding attempt.
model FundingOperation {
  id                String                 @id @default(cuid())
  userId            String
  walletId          String
  clientRequestId   String                 @db.VarChar(64)
  idempotencyKey    String                 @unique @db.VarChar(80)
  status            FundingOperationStatus @default(CREATED)
  amountMinor       BigInt
  currency          String                 @db.VarChar(3)
  raftlineAccountId String                 @db.VarChar(80)
  fundingRef        String?                @unique @db.VarChar(80)
  balanceAfterMinor BigInt?
  failureCode       String?                @db.VarChar(80)
  failureMessage    String?                @db.VarChar(500)
  attemptCount      Int                    @default(0)
  lastAttemptAt     DateTime?
  lastReconciledAt  DateTime?
  receiptVerifiedAt DateTime?
  lastWasIdempotentReplay Boolean         @default(false)
  completedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet      Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transaction TransactionRecord?

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt])
  @@index([status, lastAttemptAt])
  @@map("funding_operations")
}

/// Customer-scoped transaction read model. Entries are created before a ledger
/// call and may only reach SUCCESSFUL after a verified Raftline receipt.
model TransactionRecord {
  id                   String               @id @default(cuid())
  userId               String
  walletId             String?
  kind                 TransactionKind
  direction            TransactionDirection
  status               TransactionStatus
  amountMinor          BigInt
  currency             String               @db.VarChar(3)
  counterpartyName     String?              @db.VarChar(80)
  counterpartyUsername String?              @db.VarChar(30)
  paymentRef           String?              @db.VarChar(80)
  idempotencyKey       String?              @db.VarChar(80)
  description          String?              @db.VarChar(200)
  balanceAfterMinor    BigInt?
  occurredAt           DateTime             @default(now())
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  paymentIntentId      String?              @unique
  fundingOperationId   String?              @unique

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet           Wallet?           @relation(fields: [walletId], references: [id], onDelete: SetNull)
  paymentIntent    PaymentIntent?    @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  fundingOperation FundingOperation? @relation(fields: [fundingOperationId], references: [id], onDelete: Cascade)

  @@unique([userId, paymentRef])
  @@index([userId, occurredAt])
  @@index([userId, direction, status])
  @@index([userId, kind, status])
  @@index([status])
  @@map("transaction_records")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(60)
  entityId   String   @db.VarChar(80)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  actor User? @relation("ActorAuditEvents", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Release 3 — Contacts, requests, groups, expenses, settlements, activity
// These records are social accounting metadata. Raftline remains the only
// financial ledger; monetary transfers always reuse the Release 2 engine.
// ---------------------------------------------------------------------------

enum PaymentRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  PAID
  CANCELLED
  EXPIRED
}

enum GroupRole {
  ADMIN
  MEMBER
}

enum GroupCategory {
  HOME
  TRAVEL
  FOOD
  FRIENDS
  FAMILY
  OTHER
}

enum ExpenseCategory {
  FOOD
  TRAVEL
  ACCOMMODATION
  SHOPPING
  TRANSPORT
  ENTERTAINMENT
  UTILITIES
  OTHER
}

enum SplitMethod {
  EQUAL
  CUSTOM
  PERCENTAGE
  SHARES
}

enum SettlementStatus {
  PENDING
  PROCESSING
  SETTLED
  FAILED
  RECONCILIATION_REQUIRED
}

enum NotificationType {
  PAYMENT_REQUEST_RECEIVED
  PAYMENT_REQUEST_ACCEPTED
  PAYMENT_REQUEST_DECLINED
  PAYMENT_REQUEST_PAID
  ADDED_TO_GROUP
  GROUP_EXPENSE_CREATED
  GROUP_EXPENSE_UPDATED
  SETTLEMENT_COMPLETED
  SETTLEMENT_FAILED
}

enum GroupActivityEventType {
  GROUP_CREATED
  GROUP_UPDATED
  MEMBER_JOINED
  MEMBER_REMOVED
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  SETTLEMENT_RECORDED
  SETTLEMENT_COMPLETED
  SETTLEMENT_FAILED
}

model Contact {
  id            String   @id @default(cuid())
  ownerUserId   String
  contactUserId String
  displayLabel  String?  @db.VarChar(60)
  createdAt     DateTime @default(now())

  owner   User @relation("ContactOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  contact User @relation("ContactUser", fields: [contactUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, contactUserId])
  @@index([ownerUserId, createdAt])
  @@map("contacts")
}

model PaymentRequest {
  id              String                @id @default(cuid())
  requesterUserId String
  payerUserId     String
  amountMinor     BigInt
  currency        String                @db.VarChar(3)
  description     String?               @db.VarChar(200)
  dueAt           DateTime?
  status          PaymentRequestStatus  @default(PENDING)
  paymentRef      String?               @unique @db.VarChar(80)
  groupId         String?
  expenseId       String?
  clientRequestId String?               @unique @db.VarChar(64)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  paidAt          DateTime?

  requester User          @relation("RequestRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  payer     User          @relation("RequestPayer", fields: [payerUserId], references: [id], onDelete: Cascade)
  group     ExpenseGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  expense   Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([payerUserId, status, createdAt])
  @@index([requesterUserId, status, createdAt])
  @@index([groupId])
  @@map("payment_requests")
}

model ExpenseGroup {
  id          String         @id @default(cuid())
  name        String         @db.VarChar(80)
  description String?        @db.VarChar(400)
  category    GroupCategory  @default(OTHER)
  imageUrl    String?        @db.VarChar(2048)
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  archivedAt  DateTime?

  creator     User              @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  members     GroupMember[]
  expenses    Expense[]
  requests    PaymentRequest[]
  settlements GroupSettlement[]
  activities  GroupActivity[]

  @@index([createdAt])
  @@map("expense_groups")
}

model GroupMember {
  id        String     @id @default(cuid())
  groupId   String
  userId    String
  role      GroupRole  @default(MEMBER)
  joinedAt  DateTime   @default(now())
  removedAt DateTime?

  group ExpenseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId, removedAt])
  @@map("group_members")
}

model Expense {
  id                String          @id @default(cuid())
  groupId           String
  title             String          @db.VarChar(120)
  description       String?         @db.VarChar(400)
  totalAmountMinor  BigInt
  currency          String          @db.VarChar(3)
  paidByUserId      String
  splitMethod       SplitMethod
  category          ExpenseCategory @default(OTHER)
  expenseDate       DateTime
  createdByUserId   String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  group       ExpenseGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy      User            @relation("ExpensePayer", fields: [paidByUserId], references: [id], onDelete: Restrict)
  createdBy   User            @relation("ExpenseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  splits      ExpenseSplit[]
  requests    PaymentRequest[]

  @@index([groupId, deletedAt, expenseDate])
  @@map("expenses")
}

model ExpenseSplit {
  id               String  @id @default(cuid())
  expenseId        String
  userId           String
  shareAmountMinor BigInt
  percentage       Int?
  shares           Int?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("expense_splits")
}

model GroupSettlement {
  id             String           @id @default(cuid())
  groupId        String
  payerUserId    String
  payeeUserId    String
  amountMinor    BigInt
  currency       String           @db.VarChar(3)
  paymentRef     String?          @db.VarChar(80)
  status         SettlementStatus @default(PENDING)
  idempotencyKey String           @unique @db.VarChar(80)
  clientRequestId String          @unique @db.VarChar(64)
  paymentIntentId String?         @unique @db.VarChar(64)
  createdAt      DateTime         @default(now())
  completedAt    DateTime?

  group ExpenseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer User          @relation("SettlementPayer", fields: [payerUserId], references: [id], onDelete: Cascade)
  payee User          @relation("SettlementPayee", fields: [payeeUserId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([payerUserId, status])
  @@index([payeeUserId, status])
  @@map("group_settlements")
}

model GroupActivity {
  id              String                 @id @default(cuid())
  groupId         String
  actorUserId     String?
  eventType       GroupActivityEventType
  entityType      String                 @db.VarChar(40)
  entityId        String                 @db.VarChar(64)
  metadata        Json                   @default("{}")
  createdAt       DateTime               @default(now())

  group ExpenseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
  @@map("group_activities")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String           @db.VarChar(120)
  body      String?          @db.VarChar(400)
  data      Json             @default("{}")
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}
