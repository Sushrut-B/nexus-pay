model BillPaymentProvider {
  id          String          @id @default(cuid())
  code        String          @unique @db.VarChar(60)
  displayName String          @db.VarChar(160)
  mode        BillProviderMode @default(SANDBOX)
  status      String          @db.VarChar(30) @default("UNAVAILABLE")
  capabilities Json
  config      Json?
  lastSyncAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  capabilityRows BillPaymentProviderCapability[]
  billers        Biller[]
  webhooks       BillProviderWebhook[]
  syncJobs       BillProviderSync[]
  @@map("bill_payment_providers")
}

model BillPaymentProviderCapability {
  id         String  @id @default(cuid())
  providerId String
  capability String  @db.VarChar(60)
  enabled    Boolean @default(false)
  provider BillPaymentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  @@unique([providerId, capability])
  @@map("bill_payment_provider_capabilities")
}

model BillerCategory {
  id          String       @id @default(cuid())
  code        BillCategory @unique
  label       String       @db.VarChar(120)
  description String?      @db.VarChar(500)
  available   Boolean      @default(false)
  billers Biller[]
  @@map("biller_categories")
}

model Biller {
  id            String      @id @default(cuid())
  providerId    String
  categoryId    String
  code          String      @unique @db.VarChar(100)
  name          String      @db.VarChar(180)
  billerType    BillerType  @default(POSTPAID)
  coverage      String?     @db.VarChar(300)
  canFetchBill  Boolean     @default(false)
  canPayBill    Boolean     @default(false)
  supportsRecharge Boolean  @default(false)
  supportedModes Json       @default("[]")
  status        String      @db.VarChar(20) @default("ACTIVE")
  source        String      @db.VarChar(30) @default("SANDBOX_FIXTURE")
  lastSyncAt    DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  provider     BillPaymentProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category     BillerCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  parameters   BillerParameter[]
  versions     BillerCatalogueVersion[]
  accounts     SavedBillerAccount[]
  payments     BillPaymentIntent[]
  recharges    RechargeIntent[]
  @@index([providerId, categoryId, status])
  @@map("billers")
}

model BillerParameter {
  id          String  @id @default(cuid())
  billerId    String
  name        String  @db.VarChar(80)
  label       String  @db.VarChar(120)
  required    Boolean @default(true)
  validation  Json    @default("{}")
  sensitive   Boolean @default(false)
  displayOrder Int    @default(0)
  biller Biller @relation(fields: [billerId], references: [id], onDelete: Cascade)
  @@unique([billerId, name])
  @@map("biller_parameters")
}

