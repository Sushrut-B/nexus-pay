model RewardRiskEvent {
  id             String              @id @default(cuid())
  userId         String?
  relatedUserId  String?
  campaignId     String?
  transactionRef String?             @db.VarChar(80)
  redemptionId   String?
  severity       RiskSeverity
  reasonCode     String              @db.VarChar(60)
  description    String              @db.VarChar(500)
  status         RewardInvestigationStatus @default(OPEN)
  notes          String?             @db.VarChar(1000)
  resolvedBy     String?
