  @@map("campaign_budgets")
}

model CampaignBudgetReservation {
  id            String            @id @default(cuid())
  campaignId    String
  userId        String
  referenceType String            @db.VarChar(40)
  referenceId   String            @db.VarChar(120)
  amountMinor   Int               @default(0)
  points        Int               @default(0)
  status        ReservationStatus @default(HELD)
  expiresAt     DateTime
  createdAt     DateTime          @default(now())

  @@unique([campaignId, referenceType, referenceId])
  @@index([status, expiresAt])
  @@map("campaign_budget_reservations")
}

model CashbackEntitlement {
  id                   String         @id @default(cuid())
  userId               String
  campaignId           String
  transactionRef       String         @db.VarChar(80)
  merchantId           String?
  amountMinor          Int
  currency             String         @db.VarChar(3)
  status               CashbackStatus @default(ELIGIBILITY_PENDING)
  idempotencyKey       String         @unique @db.VarChar(160)
  fundingOperationId   String?
  paymentRef           String?        @db.VarChar(80)
  attemptCount         Int            @default(0)
  lastErrorCode        String?        @db.VarChar(80)
  failureCategory      String?        @db.VarChar(60)
  nextAttemptAt        DateTime?
  leaseUntil           DateTime?
  createdAt            DateTime       @default(now())
  resolvedAt           DateTime?

  @@unique([userId, campaignId, transactionRef])
  @@index([status, nextAttemptAt])
