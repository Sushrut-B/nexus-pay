  validity    String?  @db.VarChar(80)
  dataAllowance String? @db.VarChar(120)
  benefits    Json     @default("[]")
  terms       String?  @db.VarChar(500)
  source      String   @db.VarChar(30) @default("SANDBOX_FIXTURE")
  retrievedAt DateTime @default(now())
  snapshots RechargePlanSnapshot[]
  @@unique([billerId, code])
  @@map("recharge_plans")
}

model RechargePlanSnapshot {
  id        String   @id @default(cuid())
  planId    String
  payload   Json
  capturedAt DateTime @default(now())
  plan RechargePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  @@map("recharge_plan_snapshots")
}

model RechargeIntent {
  id               String        @id @default(cuid())
  reference        String        @unique @db.VarChar(120)
  userId           String        @db.VarChar(80)
  billerId         String
  accountId        String?       @db.VarChar(80)
  planId           String?       @db.VarChar(80)
  idempotencyKey   String        @unique @db.VarChar(160)
  providerRequestRef String      @unique @db.VarChar(160)
  amountMinor      Int
  status           RechargeStatus @default(CREATED)
  paymentIntentId  String?       @db.VarChar(120)
  paymentRef       String?       @db.VarChar(160)
  providerRef      String?       @db.VarChar(160)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  biller   Biller @relation(fields: [billerId], references: [id], onDelete: Cascade)
  attempts RechargeAttempt[]
  @@index([userId, createdAt])
  @@map("recharge_intents")
}

model RechargeAttempt {
  id          String   @id @default(cuid())
  rechargeId  String
  attemptNo   Int
  outcome     String   @db.VarChar(40)
  detail      String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  recharge RechargeIntent @relation(fields: [rechargeId], references: [id], onDelete: Cascade)
  @@unique([rechargeId, attemptNo])
  @@map("recharge_attempts")
}

model BillPaymentReceipt {
  id            String   @id @default(cuid())
  paymentId     String?  @db.VarChar(80)
  rechargeId    String?  @db.VarChar(80)
  userId        String   @db.VarChar(80)
  reference     String   @unique @db.VarChar(120)
  kind          String   @db.VarChar(40) @default("NEXUS_PAYMENT_RECORD")
  amountMinor   Int
  status        String   @db.VarChar(40)
  storagePath   String?  @db.VarChar(1024)
  fileName      String?  @db.VarChar(200)
  contentType   String?  @db.VarChar(100)
  officialProviderReceipt Boolean @default(false)
  createdAt     DateTime @default(now())
  payment BillPaymentIntent? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@map("bill_payment_receipts")
}

model RecurringBill {
