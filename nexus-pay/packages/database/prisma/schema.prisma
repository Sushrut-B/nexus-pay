  PRODUCTION
}

enum InvestmentConnectionStatus {
  NOT_CONNECTED
  CONNECTION_INITIATED
  AUTHORIZATION_PENDING
  ACTIVE
  SYNCING
  SYNC_FAILED
  CONSENT_EXPIRED
  REVOKED
  DISCONNECTED
}

enum InvestmentConsentStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
  REJECTED
}

enum InvestmentSyncStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum InvestmentAccountType {
  MUTUAL_FUND
  EQUITY
  ETF
  BOND
  RETIREMENT
  FIXED_INCOME
  OTHER
}

enum InvestmentAssetClass {
  EQUITY
  DEBT
  HYBRID
  INDEX
  ELSS
  LIQUID
  INTERNATIONAL
  SECTORAL
  GOLD
  CASH
  OTHER
}

enum InvestmentTransactionType {
  PURCHASE
  REDEMPTION
  SIP
  DIVIDEND
  INTEREST
  CORPORATE_ACTION
  MATURITY
  FEE
  OTHER
}

enum InvestmentPlanStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
  FAILED
  PENDING
  UNKNOWN
}

enum PriceFeedType {
