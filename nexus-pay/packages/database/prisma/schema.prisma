  @@index([userId, createdAt])
  @@map("bill_fetch_requests")
}

model BillSnapshot {
  id             String      @id @default(cuid())
  fetchRequestId String
  providerRef    String?     @db.VarChar(160)
  billNumber     String?     @db.VarChar(120)
  billPeriod     String?     @db.VarChar(120)
  billDate       DateTime?
  dueDate        DateTime?
  amountMinor    Int
  minAmountMinor Int?
  lateFeeMinor   Int?
  extraChargesMinor Int?
  status         String      @db.VarChar(40) @default("FETCHED")
  rawPayload     Json        @default("{}")
  fetchedAt      DateTime    @default(now())
  expiresAt      DateTime?
  fetchRequest BillFetchRequest @relation(fields: [fetchRequestId], references: [id], onDelete: Cascade)
  @@index([fetchRequestId, fetchedAt])
  @@map("bill_snapshots")
}

model BillPaymentIntent {
  id               String            @id @default(cuid())
  reference        String            @unique @db.VarChar(120)
  userId           String            @db.VarChar(80)
  billerId         String
  accountId        String?           @db.VarChar(80)
  snapshotId       String?           @db.VarChar(80)
  idempotencyKey   String            @unique @db.VarChar(160)
  providerRequestRef String          @unique @db.VarChar(160)
  amountMinor      Int
  feeMinor         Int               @default(0)
  totalMinor       Int
  status           BillPaymentStatus @default(CREATED)
  paymentIntentId  String?           @db.VarChar(120)
  paymentRef       String?           @db.VarChar(160)
  providerRef      String?           @db.VarChar(160)
  confirmedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  biller    Biller @relation(fields: [billerId], references: [id], onDelete: Cascade)
  account   SavedBillerAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  attempts  BillPaymentAttempt[]
  history   BillPaymentStatusHistory[]
  providerTransactions BillProviderTransaction[]
  receipts  BillPaymentReceipt[]
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("bill_payment_intents")
}

model BillPaymentAttempt {
  id             String    @id @default(cuid())
  paymentId      String
  attemptNo      Int
  paymentIntentId String?  @db.VarChar(120)
  outcome        String    @db.VarChar(40)
  detail         String?   @db.VarChar(500)
  createdAt      DateTime  @default(now())
  payment BillPaymentIntent @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  @@unique([paymentId, attemptNo])
  @@map("bill_payment_attempts")
}

model BillProviderTransaction {
  id          String   @id @default(cuid())
  paymentId   String
  providerRef String   @db.VarChar(160)
  status      String   @db.VarChar(40)
  payload     Json     @default("{}")
  createdAt   DateTime @default(now())
  payment BillPaymentIntent @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  @@unique([paymentId, providerRef])
  @@map("bill_provider_transactions")
}

model BillPaymentStatusHistory {
  id        String            @id @default(cuid())
  paymentId String
  fromStatus BillPaymentStatus?
  toStatus  BillPaymentStatus
  actor     String            @db.VarChar(80)
  evidence  String?           @db.VarChar(200)
  createdAt DateTime          @default(now())
  payment BillPaymentIntent @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  @@index([paymentId, createdAt])
  @@map("bill_payment_status_history")
}

model RechargePlan {
  id          String   @id @default(cuid())
  providerId  String
  billerId    String
  code        String   @db.VarChar(100)
  name        String   @db.VarChar(160)
