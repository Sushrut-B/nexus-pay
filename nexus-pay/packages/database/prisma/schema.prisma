generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum WalletStatus {
  PENDING
  PROVISIONING
  ACTIVE
  FAILED
  RECONCILIATION_REQUIRED
}

enum WalletType {
  CUSTOMER
}

enum PaymentIntentStatus {
  CREATED
  PROCESSING
  SETTLED
  REJECTED
  UNKNOWN
  RECONCILIATION_REQUIRED
}

enum FundingOperationStatus {
  CREATED
  PROCESSING
  COMPLETED
  FAILED
  UNKNOWN
  RECONCILIATION_REQUIRED
}

enum TransactionKind {
  P2P
  FUNDING
}

enum TransactionDirection {
  SENT
  RECEIVED
}

enum TransactionStatus {
  PROCESSING
  SUCCESSFUL
  FAILED
  RECONCILIATION_REQUIRED
}

model User {
  id                    String        @id @default(cuid())
  fullName              String        @db.VarChar(120)
  email                 String        @unique @db.VarChar(254)
  phoneNumber           String        @unique @db.VarChar(20)
  passwordHash          String
  username              String        @unique @db.VarChar(30)
  isEmailVerified       Boolean       @default(false)
  isPhoneVerified       Boolean       @default(false)
  accountStatus         AccountStatus @default(ACTIVE)
  emailVerifiedAt       DateTime?
  phoneVerifiedAt       DateTime?
  lastLoginAt           DateTime?
  onboardingCompletedAt DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  profile                UserProfile?
  sessions               UserSession[]
  wallets                Wallet[]
  passwordResetTokens    PasswordResetToken[]
  auditEvents            AuditEvent[]         @relation("ActorAuditEvents")
  paymentIntentsSent     PaymentIntent[]      @relation("PaymentIntentSender")
  paymentIntentsReceived PaymentIntent[]      @relation("PaymentIntentRecipient")
  fundingOperations      FundingOperation[]
  transactionRecords     TransactionRecord[]

  // Release 3 social features
  contactsOwned       Contact[]         @relation("ContactOwner")
  contactsOf          Contact[]         @relation("ContactUser")
  requestsSent        PaymentRequest[]  @relation("RequestRequester")
  requestsReceived    PaymentRequest[]  @relation("RequestPayer")
  groupsCreated       ExpenseGroup[]    @relation("GroupCreator")
  groupMemberships    GroupMember[]
  expensesPaid        Expense[]         @relation("ExpensePayer")
  expensesCreated     Expense[]         @relation("ExpenseCreator")
  expenseSplits       ExpenseSplit[]
  settlementsPaid     GroupSettlement[] @relation("SettlementPayer")
  settlementsReceived GroupSettlement[] @relation("SettlementPayee")
  activities          GroupActivity[]
  notifications       Notification[]

  // Release 4 — personal finance intelligence
  categories          TransactionCategory[]   @relation("UserCategory")
  categorizations     TransactionCategorization[]
  categorizationRules CategorizationRule[]
  budgets             Budget[]
  savingsGoals        SavingsGoal[]
  scheduledPayments   ScheduledPayment[]     @relation("ScheduleOwner")
  scheduledRecipients ScheduledPayment[]     @relation("ScheduleRecipient")
  recurringSuggestions RecurringPaymentSuggestion[]
  statements          Statement[]

  // Release 6 — Merchant ecosystem
  merchantOwners      Merchant[]          @relation("MerchantOwner")
  merchantMemberships MerchantMember[]
  merchantPayments    MerchantPayment[]   @relation("MerchantCustomer")
  subscriptions       Subscription[]      @relation("SubscriptionCustomer")
  invoices            Invoice[]           @relation("InvoiceCustomer")

  @@index([accountStatus])
  @@index([createdAt])
  @@map("users")
}

model UserProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  displayName       String   @db.VarChar(60)
  avatarUrl         String?  @db.VarChar(2048)
  preferredCurrency String   @default("INR") @db.VarChar(3)
  preferredLanguage String   @default("en-IN") @db.VarChar(10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  sessionTokenHash String    @unique @db.VarChar(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  ipAddress        String?   @db.VarChar(64)
  userAgent        String?   @db.VarChar(512)
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Wallet {
  id                    String       @id @default(cuid())
  userId                String
  raftlineAccountId     String?      @unique @db.VarChar(80)
  currency              String       @default("INR") @db.VarChar(3)
  walletType            WalletType   @default(CUSTOMER)
  status                WalletStatus @default(PENDING)
  provisioningAttempts  Int          @default(0)
  lastProvisioningError String?      @db.Text
  provisionedAt         DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentIntents    PaymentIntent[]
  fundingOperations FundingOperation[]
  transactions      TransactionRecord[]
  scheduledPaymentsSource      ScheduledPayment[] @relation("ScheduleSourceWallet")
  scheduledPaymentsDestination ScheduledPayment[] @relation("ScheduleDestinationWallet")

  @@unique([userId, currency])
  @@index([status])
  @@map("wallets")
}

/// Durable intent for one P2P payment. A client request id is the customer-facing
/// idempotency boundary; the ledger idempotency key is generated once and never
/// replaced, even after a timeout or ambiguous outcome.
model PaymentIntent {
  id                   String              @id @default(cuid())
  userId               String
  walletId             String
  recipientUserId      String?
  clientRequestId      String              @db.VarChar(64)
  idempotencyKey       String              @unique @db.VarChar(80)
  status               PaymentIntentStatus @default(CREATED)
  recipientUsername    String              @db.VarChar(30)
  recipientDisplayName String              @db.VarChar(60)
  sourceAccountId      String              @db.VarChar(80)
  destinationAccountId String              @db.VarChar(80)
  amountMinor          BigInt
  currency             String              @db.VarChar(3)
  description          String?             @db.VarChar(140)
  paymentRef           String?             @unique @db.VarChar(80)
  raftLogIndex         BigInt?
  rejectionCode        String?             @db.VarChar(80)
  failureMessage       String?             @db.VarChar(500)
  attemptCount         Int                 @default(0)
  lastAttemptAt        DateTime?
  lastReconciledAt     DateTime?
  receiptVerifiedAt    DateTime?
  lastWasIdempotentReplay Boolean          @default(false)
  settledAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user        User               @relation("PaymentIntentSender", fields: [userId], references: [id], onDelete: Cascade)
  recipient   User?              @relation("PaymentIntentRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  wallet      Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transaction TransactionRecord?

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([status, lastAttemptAt])
  @@map("payment_intents")
}

/// Durable record of one simulated INR sandbox funding attempt.
model FundingOperation {
  id                String                 @id @default(cuid())
  userId            String
  walletId          String
  clientRequestId   String                 @db.VarChar(64)
  idempotencyKey    String                 @unique @db.VarChar(80)
  status            FundingOperationStatus @default(CREATED)
  amountMinor       BigInt
  currency          String                 @db.VarChar(3)
  raftlineAccountId String                 @db.VarChar(80)
  fundingRef        String?                @unique @db.VarChar(80)
  balanceAfterMinor BigInt?
  failureCode       String?                @db.VarChar(80)
  failureMessage    String?                @db.VarChar(500)
  attemptCount      Int                    @default(0)
  lastAttemptAt     DateTime?
  lastReconciledAt  DateTime?
  receiptVerifiedAt DateTime?
  lastWasIdempotentReplay Boolean         @default(false)
  completedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet      Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transaction TransactionRecord?

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt])
  @@index([status, lastAttemptAt])
  @@map("funding_operations")
}

/// Customer-scoped transaction read model. Entries are created before a ledger
/// call and may only reach SUCCESSFUL after a verified Raftline receipt.
model TransactionRecord {
  id                   String               @id @default(cuid())
  userId               String
  walletId             String?
  kind                 TransactionKind
  direction            TransactionDirection
  status               TransactionStatus
  amountMinor          BigInt
  currency             String               @db.VarChar(3)
  counterpartyName     String?              @db.VarChar(80)
  counterpartyUsername String?              @db.VarChar(30)
  paymentRef           String?              @db.VarChar(80)
  idempotencyKey       String?              @db.VarChar(80)
  description          String?              @db.VarChar(200)
  balanceAfterMinor    BigInt?
  occurredAt           DateTime             @default(now())
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  paymentIntentId      String?              @unique
  fundingOperationId   String?              @unique

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet           Wallet?           @relation(fields: [walletId], references: [id], onDelete: SetNull)
  paymentIntent    PaymentIntent?    @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  fundingOperation FundingOperation? @relation(fields: [fundingOperationId], references: [id], onDelete: Cascade)

  @@unique([userId, paymentRef])
  @@index([userId, occurredAt])
  @@index([userId, direction, status])
  @@index([userId, kind, status])
  @@index([status])
  @@map("transaction_records")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(60)
  entityId   String   @db.VarChar(80)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  actor User? @relation("ActorAuditEvents", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Release 3 — Contacts, requests, groups, expenses, settlements, activity
// These records are social accounting metadata. Raftline remains the only
// financial ledger; monetary transfers always reuse the Release 2 engine.
// ---------------------------------------------------------------------------

enum PaymentRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  PAID
  CANCELLED
  EXPIRED
}

enum GroupRole {
  ADMIN
  MEMBER
}

enum GroupCategory {
  HOME
  TRAVEL
  FOOD
  FRIENDS
  FAMILY
  OTHER
}

enum ExpenseCategory {
  FOOD
  TRAVEL
  ACCOMMODATION
  SHOPPING
  TRANSPORT
  ENTERTAINMENT
  UTILITIES
  OTHER
}

enum SplitMethod {
  EQUAL
  CUSTOM
  PERCENTAGE
  SHARES
}

enum SettlementStatus {
  PENDING
  PROCESSING
  SETTLED
  FAILED
  RECONCILIATION_REQUIRED
}

enum NotificationType {
  PAYMENT_REQUEST_RECEIVED
  PAYMENT_REQUEST_ACCEPTED
  PAYMENT_REQUEST_DECLINED
  PAYMENT_REQUEST_PAID
  ADDED_TO_GROUP
  GROUP_EXPENSE_CREATED
  GROUP_EXPENSE_UPDATED
  SETTLEMENT_COMPLETED
  SETTLEMENT_FAILED
  BUDGET_THRESHOLD_REACHED
  BUDGET_EXCEEDED
  SCHEDULED_PAYMENT_DUE
  SCHEDULED_PAYMENT_COMPLETED
  SCHEDULED_PAYMENT_FAILED
  SCHEDULED_PAYMENT_ATTENTION
  SAVINGS_GOAL_COMPLETED
  STATEMENT_AVAILABLE
  MERCHANT_PAYMENT_RECEIVED
  MERCHANT_PAYMENT_FAILED
  MERCHANT_ORDER_CREATED
  MERCHANT_REFUND_REQUESTED
  MERCHANT_REFUND_OUTCOME
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_TRIAL_ENDING
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_RENEWAL_SUCCEEDED
  SUBSCRIPTION_RENEWAL_FAILED
  SUBSCRIPTION_PAST_DUE
  SUBSCRIPTION_CANCELLED
  SUBSCRIPTION_PLAN_CHANGED
  SUBSCRIPTION_INVOICE_AVAILABLE
}

enum GroupActivityEventType {
  GROUP_CREATED
  GROUP_UPDATED
  MEMBER_JOINED
  MEMBER_REMOVED
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  SETTLEMENT_RECORDED
  SETTLEMENT_COMPLETED
  SETTLEMENT_FAILED
}

model Contact {
  id            String   @id @default(cuid())
  ownerUserId   String
  contactUserId String
  displayLabel  String?  @db.VarChar(60)
  createdAt     DateTime @default(now())

  owner   User @relation("ContactOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  contact User @relation("ContactUser", fields: [contactUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, contactUserId])
  @@index([ownerUserId, createdAt])
  @@map("contacts")
}

model PaymentRequest {
  id              String                @id @default(cuid())
  requesterUserId String
  payerUserId     String
  amountMinor     BigInt
  currency        String                @db.VarChar(3)
  description     String?               @db.VarChar(200)
  dueAt           DateTime?
  status          PaymentRequestStatus  @default(PENDING)
  paymentRef      String?               @unique @db.VarChar(80)
  groupId         String?
  expenseId       String?
  clientRequestId String?               @unique @db.VarChar(64)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  paidAt          DateTime?

  requester User          @relation("RequestRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  payer     User          @relation("RequestPayer", fields: [payerUserId], references: [id], onDelete: Cascade)
  group     ExpenseGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  expense   Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([payerUserId, status, createdAt])
  @@index([requesterUserId, status, createdAt])
  @@index([groupId])
  @@map("payment_requests")
}

model ExpenseGroup {
  id          String         @id @default(cuid())
  name        String         @db.VarChar(80)
  description String?        @db.VarChar(400)
  category    GroupCategory  @default(OTHER)
  imageUrl    String?        @db.VarChar(2048)
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  archivedAt  DateTime?

  creator     User              @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  members     GroupMember[]
  expenses    Expense[]
  requests    PaymentRequest[]
  settlements GroupSettlement[]
  activities  GroupActivity[]

  @@index([createdAt])
  @@map("expense_groups")
}

model GroupMember {
  id        String     @id @default(cuid())
  groupId   String
  userId    String
  role      GroupRole  @default(MEMBER)
  joinedAt  DateTime   @default(now())
  removedAt DateTime?

  group ExpenseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId, removedAt])
  @@map("group_members")
}

model Expense {
  id                String          @id @default(cuid())
  groupId           String
  title             String          @db.VarChar(120)
  description       String?         @db.VarChar(400)
  totalAmountMinor  BigInt
  currency          String          @db.VarChar(3)
  paidByUserId      String
  splitMethod       SplitMethod
  category          ExpenseCategory @default(OTHER)
  expenseDate       DateTime
  createdByUserId   String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  group       ExpenseGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy      User            @relation("ExpensePayer", fields: [paidByUserId], references: [id], onDelete: Restrict)
  createdBy   User            @relation("ExpenseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  splits      ExpenseSplit[]
  requests    PaymentRequest[]

  @@index([groupId, deletedAt, expenseDate])
  @@map("expenses")
}

model ExpenseSplit {
  id               String  @id @default(cuid())
  expenseId        String
  userId           String
  shareAmountMinor BigInt
  percentage       Int?
  shares           Int?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("expense_splits")
}

model GroupSettlement {
  id             String           @id @default(cuid())
  groupId        String
  payerUserId    String
  payeeUserId    String
  amountMinor    BigInt
  currency       String           @db.VarChar(3)
  paymentRef     String?          @db.VarChar(80)
  status         SettlementStatus @default(PENDING)
  idempotencyKey String           @unique @db.VarChar(80)
  clientRequestId String          @unique @db.VarChar(64)
  paymentIntentId String?         @unique @db.VarChar(64)
  createdAt      DateTime         @default(now())
  completedAt    DateTime?

  group ExpenseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer User          @relation("SettlementPayer", fields: [payerUserId], references: [id], onDelete: Cascade)
  payee User          @relation("SettlementPayee", fields: [payeeUserId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([payerUserId, status])
  @@index([payeeUserId, status])
  @@map("group_settlements")
}

model GroupActivity {
  id              String                 @id @default(cuid())
  groupId         String
  actorUserId     String?
  eventType       GroupActivityEventType
  entityType      String                 @db.VarChar(40)
  entityId        String                 @db.VarChar(64)
  metadata        Json                   @default("{}")
  createdAt       DateTime               @default(now())

  group ExpenseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
  @@map("group_activities")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String           @db.VarChar(120)
  body      String?          @db.VarChar(400)
  data      Json             @default("{}")
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Release 4 — Personal finance intelligence
// Analytics are derived from verified transactions. Raftline remains the only
// financial ledger; nothing here is an independent source of truth.
// ---------------------------------------------------------------------------

enum CategoryType {
  FOOD_DINING
  GROCERIES
  SHOPPING
  TRANSPORT
  TRAVEL
  ENTERTAINMENT
  RENT_HOUSING
  UTILITIES
  HEALTHCARE
  EDUCATION
  SUBSCRIPTIONS
  PERSONAL_TRANSFERS
  GROUP_EXPENSES
  INCOME
  OTHER
  UNCATEGORIZED
}

enum CategorizationSource {
  SYSTEM_RULE
  USER_RULE
  MANUAL
}

enum RuleConditionType {
  CONTAINS
  STARTS_WITH
  ENDS_WITH
  EXACT
}

enum BudgetPeriodType {
  WEEKLY
  MONTHLY
  CUSTOM
}

enum BudgetStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum SavingsGoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ContributionType {
  PLANNED
  RECORDED
}

enum ScheduleFrequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ScheduleStatus {
  DRAFT
  ACTIVE
  PAUSED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REQUIRES_ATTENTION
}

enum ExecutionStatus {
  PENDING
  PROCESSING
  SETTLED
  FAILED
  RETRY_PENDING
  CANCELLED
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  UNKNOWN
}

enum RecurringSuggestionStatus {
  SUGGESTED
  CONFIRMED
  IGNORED
}

enum StatementFormat {
  PDF
  CSV
}

enum StatementStatus {
  GENERATING
  READY
  FAILED
}

model TransactionCategory {
  id           String          @id @default(cuid())
  userId       String?
  name         String          @db.VarChar(60)
  categoryType CategoryType
  icon         String?         @db.VarChar(40)
  isSystem     Boolean         @default(false)
  createdAt    DateTime        @default(now())

  user           User?                     @relation("UserCategory", fields: [userId], references: [id], onDelete: Cascade)
  categorizations TransactionCategorization[]
  rules           CategorizationRule[]
  budgets         Budget[]

  @@unique([userId, name])
  @@index([isSystem, categoryType])
  @@map("transaction_categories")
}

model TransactionCategorization {
  id                   String               @id @default(cuid())
  paymentRef           String               @db.VarChar(80)
  userId               String
  categoryId           String
  note                 String?              @db.VarChar(200)
  categorizationSource CategorizationSource
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, paymentRef])
  @@index([categoryId])
  @@map("transaction_categorizations")
}

model CategorizationRule {
  id             String             @id @default(cuid())
  userId         String
  conditionType  RuleConditionType
  conditionValue String             @db.VarChar(120)
  categoryId     String
  priority       Int                @default(100)
  isEnabled      Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, isEnabled, priority])
  @@map("categorization_rules")
}

model Budget {
  id           String           @id @default(cuid())
  userId       String
  name         String           @db.VarChar(80)
  categoryId   String
  amountMinor  BigInt
  currency     String           @db.VarChar(3)
  periodType   BudgetPeriodType
  startDate    DateTime
  endDate      DateTime?
  thresholds   Int[]            @default([50, 75, 90, 100])
  status       BudgetStatus     @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  alerts   BudgetAlert[]

  @@index([userId, status, startDate])
  @@map("budgets")
}

model BudgetAlert {
  id                 String   @id @default(cuid())
  budgetId           String
  periodStart        DateTime
  thresholdPercentage Int
  notifiedAt         DateTime @default(now())

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, periodStart, thresholdPercentage])
  @@map("budget_alerts")
}

model SavingsGoal {
  id                String            @id @default(cuid())
  userId            String
  name              String            @db.VarChar(80)
  targetAmountMinor BigInt
  currency          String            @db.VarChar(3)
  targetDate        DateTime?
  description       String?           @db.VarChar(400)
  icon              String?           @db.VarChar(40)
  status            SavingsGoalStatus @default(ACTIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions SavingsContribution[]

  @@index([userId, status])
  @@map("savings_goals")
}

model SavingsContribution {
  id               String           @id @default(cuid())
  goalId           String
  amountMinor      BigInt
  contributionType ContributionType
  relatedPaymentRef String?         @db.VarChar(80)
  note             String?          @db.VarChar(200)
  createdAt        DateTime         @default(now())

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
  @@map("savings_contributions")
}

model ScheduledPayment {
  id                 String            @id @default(cuid())
  userId             String
  recipientUserId    String
  sourceWalletId     String
  destinationWalletId String
  amountMinor        BigInt
  currency           String            @db.VarChar(3)
  description        String?           @db.VarChar(200)
  frequency          ScheduleFrequency
  startDate          DateTime
  endDate            DateTime?
  nextExecutionAt    DateTime
  maxExecutions      Int?
  executionCount     Int               @default(0)
  status             ScheduleStatus    @default(DRAFT)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user             User                      @relation("ScheduleOwner", fields: [userId], references: [id], onDelete: Cascade)
  recipient        User                      @relation("ScheduleRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  sourceWallet     Wallet                    @relation("ScheduleSourceWallet", fields: [sourceWalletId], references: [id], onDelete: Cascade)
  destinationWallet Wallet                   @relation("ScheduleDestinationWallet", fields: [destinationWalletId], references: [id], onDelete: Cascade)
  executions       ScheduledPaymentExecution[]

  @@index([userId, status, nextExecutionAt])
  @@index([status, nextExecutionAt])
  @@map("scheduled_payments")
}

model ScheduledPaymentExecution {
  id                  String         @id @default(cuid())
  scheduledPaymentId  String
  executionKey        String         @unique @db.VarChar(120)
  paymentRef          String?        @db.VarChar(80)
  scheduledFor        DateTime
  status              ExecutionStatus @default(PENDING)
  attemptCount        Int            @default(0)
  lastErrorCode       String?        @db.VarChar(80)
  nextAttemptAt       DateTime?
  executedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  scheduledPayment ScheduledPayment @relation(fields: [scheduledPaymentId], references: [id], onDelete: Cascade)

  @@index([scheduledPaymentId, scheduledFor])
  @@index([status, nextAttemptAt])
  @@map("scheduled_payment_executions")
}

model RecurringPaymentSuggestion {
  id                   String                   @id @default(cuid())
  userId               String
  counterparty         String                   @db.VarChar(80)
  counterpartyUsername String?                  @db.VarChar(30)
  amountMinor          BigInt
  currency             String                   @db.VarChar(3)
  suggestedFrequency   RecurringFrequency
  lastObservedAt       DateTime
  nextExpectedAt       DateTime?
  confidence           Int
  status               RecurringSuggestionStatus @default(SUGGESTED)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, counterpartyUsername, amountMinor])
  @@index([userId, status])
  @@map("recurring_payment_suggestions")
}

// ---------------------------------------------------------------------------
// Release 5 — Nexus Control (administrative operations)
// These records observe and audit infrastructure. They are never a financial
// ledger and never modify Raftline's authoritative state.
// ---------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  OPERATOR
  VIEWER
}

enum ClusterHealth {
  HEALTHY
  DEGRADED
  NO_LEADER
  QUORUM_LOST
  NODE_UNAVAILABLE
  RECOVERING
  UNKNOWN
}

enum ChaosOperationStatus {
  REQUESTED
  INJECTED
  HEALED
  FAILED
  BLOCKED
}

enum AlertSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFORMATIONAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum ReconciliationStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_SETTLED
  RESOLVED_REJECTED
  UNRESOLVED
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique @db.VarChar(254)
  username     String     @unique @db.VarChar(30)
  passwordHash String     @db.VarChar(255)
  role         AdminRole  @default(VIEWER)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?

  sessions       AdminSession[]
  chaosOperations ChaosOperation[]
  reconciliations ReconciliationCase[]

  @@index([role, isActive])
  @@map("admin_users")
}

model AdminSession {
  id           String    @id @default(cuid())
  adminUserId  String
  tokenHash    String    @unique @db.VarChar(64)
  expiresAt    DateTime
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  ipAddress    String?   @db.VarChar(64)
  userAgent    String?   @db.VarChar(512)
  createdAt    DateTime  @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
  @@map("admin_sessions")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @db.VarChar(64)
  actorEmail String?  @db.VarChar(254)
  actorRole  String   @db.VarChar(30)
  action     String   @db.VarChar(80)
  targetType String   @db.VarChar(60)
  targetId   String   @db.VarChar(80)
  reason     String?  @db.VarChar(500)
  requestId  String?  @db.VarChar(64)
  ipAddress  String?  @db.VarChar(64)
  outcome    String   @db.VarChar(30)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

model ClusterSnapshot {
  id             String        @id @default(cuid())
  observedAt     DateTime      @default(now())
  leaderId       String?       @db.VarChar(40)
  term           BigInt?
  commitIndex    BigInt?
  lastApplied    BigInt?
  healthyNodes   Int
  unavailableNodes Int
  quorum         Int
  totalNodes     Int
  health         ClusterHealth
  capturedMs     Int
  nodes          NodeObservation[]

  @@index([observedAt])
  @@index([leaderId, observedAt])
  @@map("cluster_snapshots")
}

model NodeObservation {
  id             String    @id @default(cuid())
  snapshotId     String
  nodeId         String    @db.VarChar(40)
  reachable      Boolean
  role           String?   @db.VarChar(30)
  term           BigInt?
  commitIndex    BigInt?
  lastApplied    BigInt?
  responseTimeMs Int
  error          String?   @db.VarChar(300)
  observedAt     DateTime  @default(now())

  snapshot ClusterSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, nodeId])
  @@index([nodeId, observedAt])
  @@map("node_observations")
}

model LeaderTransition {
  id            String   @id @default(cuid())
  fromLeaderId  String?  @db.VarChar(40)
  toLeaderId    String?  @db.VarChar(40)
  term          BigInt?
  observedAt    DateTime @default(now())
  source        String   @default("OBSERVED") @db.VarChar(30)
  snapshotId    String?

  @@index([observedAt])
  @@index([toLeaderId, observedAt])
  @@map("leader_transitions")
}

model ChaosOperation {
  id            String               @id @default(cuid())
  actorId       String
  actorRole     String               @db.VarChar(30)
  nodeId        String               @db.VarChar(40)
  scenario      String               @db.VarChar(40)
  target        String?              @db.VarChar(80)
  peer          String?              @db.VarChar(40)
  reason        String               @db.VarChar(500)
  status        ChaosOperationStatus @default(REQUESTED)
  requestId     String               @unique @db.VarChar(80)
  request       Json
  response      Json                 @default("{}")
  error         String?              @db.VarChar(400)
  requestedAt   DateTime             @default(now())
  completedAt   DateTime?
  events        ChaosOperationEvent[]

  actor AdminUser @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([nodeId, requestedAt])
  @@index([status, requestedAt])
  @@map("chaos_operations")
}

model ChaosOperationEvent {
  id          String   @id @default(cuid())
  operationId String
  eventType   String   @db.VarChar(40)
  message     String   @db.VarChar(400)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  operation ChaosOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId, createdAt])
  @@map("chaos_operation_events")
}

model OperationalAlert {
  id               String        @id @default(cuid())
  fingerprint      String        @unique @db.VarChar(120)
  title            String        @db.VarChar(160)
  description      String        @db.VarChar(600)
  severity         AlertSeverity
  status           AlertStatus   @default(OPEN)
  nodeId           String?       @db.VarChar(40)
  paymentRef       String?       @db.VarChar(80)
  suggestedSteps   String?       @db.VarChar(600)
  firstDetectedAt  DateTime      @default(now())
  lastObservedAt   DateTime      @default(now())
  resolvedAt       DateTime?
  acknowledgedBy   String?       @db.VarChar(64)
  acknowledgedAt   DateTime?
  metadata         Json          @default("{}")

  @@index([status, severity, lastObservedAt])
  @@map("operational_alerts")
}

model ReconciliationCase {
  id                String               @id @default(cuid())
  paymentIntentId   String               @db.VarChar(64)
  paymentRef        String?              @db.VarChar(80)
  idempotencyKey    String               @db.VarChar(80)
  applicationStatus String               @db.VarChar(40)
  status            ReconciliationStatus @default(OPEN)
  decision          String?              @db.VarChar(200)
  reason            String?              @db.VarChar(500)
  operatorId        String?
  evidence          Json                 @default("{}")
  createdAt         DateTime             @default(now())
  resolvedAt        DateTime?

  operator   AdminUser?            @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  attempts   ReconciliationAttempt[]

  @@unique([paymentIntentId])
  @@index([status, createdAt])
  @@map("reconciliation_cases")
}

model ReconciliationAttempt {
  id         String   @id @default(cuid())
  caseId     String
  operatorId String?  @db.VarChar(64)
  outcome    String   @db.VarChar(60)
  evidence   Json     @default("{}")
  error      String?  @db.VarChar(400)
  createdAt  DateTime @default(now())

  case ReconciliationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("reconciliation_attempts")
}

// ---------------------------------------------------------------------------
// Release 6 — Merchant ecosystem
// Merchant records are application metadata. Raftline remains authoritative
// for all money movement and balances.
// ---------------------------------------------------------------------------

enum MerchantType {
  INDIVIDUAL_BUSINESS
  SOLE_PROPRIETORSHIP
  SMALL_BUSINESS
  COMPANY
  ENTERPRISE
}

enum MerchantStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MerchantRole {
  OWNER
  ADMIN
  STAFF
}

enum MerchantOrderStatus {
  DRAFT
  CREATED
  PAYMENT_PENDING
  PARTIALLY_PAID
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentLinkStatus {
  DRAFT
  ACTIVE
  PAID
  EXPIRED
  CANCELLED
  DISABLED
}

enum RefundStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  SUCCEEDED
  FAILED
  REJECTED
  UNKNOWN
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRY_PENDING
  DEAD_LETTER
}

model Merchant {
  id              String        @id @default(cuid())
  ownerUserId     String
  handle          String        @unique @db.VarChar(40)
  businessName    String        @db.VarChar(120)
  displayName     String        @db.VarChar(120)
  businessType    MerchantType
  category        String        @db.VarChar(60)
  description     String?       @db.VarChar(600)
  email           String        @db.VarChar(254)
  phone           String        @db.VarChar(20)
  website         String?       @db.VarChar(2048)
  address         String?       @db.VarChar(400)
  logoUrl         String?       @db.VarChar(2048)
  brandColor      String?       @db.VarChar(20)
  supportEmail    String?       @db.VarChar(254)
  supportPhone    String?       @db.VarChar(20)
  refundPolicy    String?       @db.VarChar(1000)
  currency        String        @db.VarChar(3)
  status          MerchantStatus @default(DRAFT)
  raftlineAccountId String?     @unique @db.VarChar(80)
  walletId        String?       @db.VarChar(64)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  owner          User                    @relation("MerchantOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members        MerchantMember[]
  approvalEvents MerchantApprovalEvent[]
  orders         MerchantOrder[]
  links          MerchantPaymentLink[]
  sessions       MerchantCheckoutSession[]
  payments       MerchantPayment[]
  customers      MerchantCustomer[]
  refunds        MerchantRefundRequest[]
  apiKeys        MerchantApiKey[]
  webhooks       MerchantWebhookEndpoint[]
  webhookEvents  MerchantWebhookEvent[]
  reportExports  MerchantReportExport[]
  plans          SubscriptionPlan[]
  subscriptions  Subscription[]
  occurrences    BillingOccurrence[]
  invoices       Invoice[]
  invoiceSequences InvoiceNumberSequence[]
  planChanges    PlanChange[]
  subscriptionEvents SubscriptionEvent[]

  @@index([ownerUserId, status])
  @@index([status, createdAt])
  @@map("merchants")
}

model MerchantMember {
  id         String       @id @default(cuid())
  merchantId String
  userId     String
  role       MerchantRole @default(STAFF)
  joinedAt   DateTime     @default(now())
  removedAt  DateTime?

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([merchantId, userId])
  @@map("merchant_members")
}

model MerchantApprovalEvent {
  id          String         @id @default(cuid())
  merchantId  String
  actorAdminId String?
  fromStatus  MerchantStatus
  toStatus    MerchantStatus
  reason      String?        @db.VarChar(500)
  createdAt   DateTime       @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt])
  @@map("merchant_approval_events")
}

model MerchantOrder {
  id             String              @id @default(cuid())
  merchantId     String
  title          String              @db.VarChar(120)
  description    String?             @db.VarChar(600)
  customerName   String?             @db.VarChar(120)
  customerEmail  String?             @db.VarChar(254)
  customerPhone  String?             @db.VarChar(20)
  subtotalMinor  Int
  taxMinor       Int                 @default(0)
  discountMinor  Int                 @default(0)
  totalMinor     Int
  currency       String              @db.VarChar(3)
  status         MerchantOrderStatus @default(CREATED)
  expiresAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  merchant Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  items    MerchantOrderItem[]
  payments MerchantPayment[]
  links    MerchantPaymentLink[]
  sessions MerchantCheckoutSession[]
  refunds  MerchantRefundRequest[]

  @@index([merchantId, status, createdAt])
  @@map("merchant_orders")
}

model MerchantOrderItem {
  id              String @id @default(cuid())
  orderId         String
  title           String @db.VarChar(160)
  quantity        Int
  unitPriceMinor  Int
  lineTotalMinor  Int
  sku             String? @db.VarChar(80)

  order MerchantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("merchant_order_items")
}

model MerchantCustomer {
  id              String    @id @default(cuid())
  merchantId      String
  userId          String?
  displayName     String    @db.VarChar(120)
  email           String?   @db.VarChar(254)
  phone           String?   @db.VarChar(20)
  totalPaidMinor  Int       @default(0)
  orderCount      Int       @default(0)
  firstPurchaseAt DateTime?
  lastPurchaseAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, userId])
  @@index([merchantId, lastPurchaseAt])
  @@map("merchant_customers")
}

model MerchantPayment {
  id              String    @id @default(cuid())
  merchantId      String
  orderId         String?
  customerUserId  String
  paymentIntentId String    @unique @db.VarChar(64)
  paymentRef      String    @unique @db.VarChar(80)
  idempotencyKey  String    @db.VarChar(80)
  amountMinor     Int
  currency        String    @db.VarChar(3)
  status          String    @db.VarChar(40)
  source          String    @db.VarChar(30)
  refundedMinor   Int       @default(0)
  createdAt       DateTime  @default(now())
  settledAt       DateTime?

  merchant Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order    MerchantOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer User           @relation("MerchantCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  refunds  MerchantRefundRequest[]

  @@index([merchantId, createdAt])
  @@index([customerUserId, createdAt])
  @@map("merchant_payments")
}

model MerchantCheckoutSession {
  id           String    @id @default(cuid())
  merchantId   String
  orderId      String?
  token        String    @unique @db.VarChar(80)
  clientRequestId String @unique @db.VarChar(64)
  status       String    @db.VarChar(30)
  expiresAt    DateTime
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  merchant Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order    MerchantOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([merchantId, createdAt])
  @@map("merchant_checkout_sessions")
}

model MerchantPaymentLink {
  id            String            @id @default(cuid())
  merchantId    String
  orderId       String?
  token         String            @unique @db.VarChar(80)
  title         String            @db.VarChar(120)
  description   String?           @db.VarChar(600)
  amountMinor   Int
  currency      String            @db.VarChar(3)
  customerName  String?           @db.VarChar(120)
  customerEmail String?           @db.VarChar(254)
  maxPayments   Int?
  paymentCount  Int               @default(0)
  totalCollectedMinor Int         @default(0)
  status        PaymentLinkStatus @default(ACTIVE)
  expiresAt     DateTime?
  redirectUrl   String?           @db.VarChar(2048)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  merchant Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order    MerchantOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([merchantId, status, createdAt])
  @@map("merchant_payment_links")
}

model MerchantRefundRequest {
  id              String       @id @default(cuid())
  merchantId      String
  paymentId       String
  orderId         String?
  amountMinor     Int
  reason          String       @db.VarChar(500)
  type            String       @db.VarChar(20)
  status          RefundStatus @default(REQUESTED)
  requestedBy     String
  reviewedBy      String?
  reviewNote      String?      @db.VarChar(500)
  executionNote   String?      @db.VarChar(500)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  resolvedAt      DateTime?

  merchant Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  payment  MerchantPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order    MerchantOrder?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([merchantId, status, createdAt])
  @@map("merchant_refund_requests")
}

model MerchantApiKey {
  id          String    @id @default(cuid())
  merchantId  String
  name        String    @db.VarChar(80)
  keyPrefix   String    @db.VarChar(20)
  keyHash     String    @unique @db.VarChar(64)
  scopes      String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, revokedAt])
  @@map("merchant_api_keys")
}

model MerchantWebhookEndpoint {
  id           String   @id @default(cuid())
  merchantId   String
  url          String   @db.VarChar(2048)
  events       String[]
  enabled      Boolean  @default(true)
  signingSecret String  @db.VarChar(128)
  createdAt    DateTime @default(now())

  merchant  Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  deliveries MerchantWebhookDelivery[]

  @@index([merchantId, enabled])
  @@map("merchant_webhook_endpoints")
}

model MerchantWebhookEvent {
  id          String   @id @default(cuid())
  merchantId  String
  eventType   String   @db.VarChar(60)
  payload     Json
  status      String   @db.VarChar(30)
  availableAt DateTime @default(now())
  createdAt   DateTime @default(now())

  merchant  Merchant                 @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  deliveries MerchantWebhookDelivery[]

  @@index([status, availableAt])
  @@map("merchant_webhook_events")
}

model MerchantWebhookDelivery {
  id           String                @id @default(cuid())
  eventId      String
  endpointId   String
  attempt      Int                   @default(1)
  status       WebhookDeliveryStatus @default(PENDING)
  responseCode Int?
  error        String?               @db.VarChar(500)
  nextAttemptAt DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime              @default(now())

  event    MerchantWebhookEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint MerchantWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("merchant_webhook_deliveries")
}

model MerchantReportExport {
  id        String   @id @default(cuid())
  merchantId String
  type      String   @db.VarChar(40)
  format    String   @db.VarChar(10)
  fileName  String   @db.VarChar(200)
  fileSize  Int
  createdAt DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt])
  @@map("merchant_report_exports")
}

// ---------------------------------------------------------------------------
// Release 7 — Subscriptions & recurring billing
// Raftline remains authoritative for money movement and balances. Everything
// below is billing metadata and orchestration state only.
// ---------------------------------------------------------------------------

enum BillingFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PlanVisibility {
  PUBLIC
  PRIVATE
}

enum SubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLATION_SCHEDULED
  CANCELLED
  EXPIRED
  INCOMPLETE
  REQUIRES_CUSTOMER_ACTION
}

enum CancellationTiming {
  IMMEDIATE
  END_OF_PERIOD
}

enum BillingOccurrenceStatus {
  PENDING
  PROCESSING
  SETTLED
  FAILED
  UNRESOLVED
  RECONCILIATION_REQUIRED
  DEAD_LETTER
  SKIPPED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PROCESSING
  PAID
  PAST_DUE
  VOID
  UNCOLLECTIBLE
}

model SubscriptionPlan {
  id                 String         @id @default(cuid())
  merchantId         String
  name               String         @db.VarChar(120)
  description        String?        @db.VarChar(1000)
  imageUrl           String?        @db.VarChar(2048)
  amountMinor        Int
  setupFeeMinor      Int            @default(0)
  currency           String         @db.VarChar(3)
  frequency          BillingFrequency
  intervalCount      Int            @default(1)
  trialDays          Int            @default(0)
  introPriceMinor    Int?
  introPeriods       Int            @default(0)
  maxBillingPeriods  Int?
  cancellationPolicy String?        @db.VarChar(1000)
  visibility         PlanVisibility @default(PUBLIC)
  status             PlanStatus     @default(DRAFT)
  checkoutToken      String         @unique @db.VarChar(80)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  merchant       Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  subscriptions  Subscription[]
  changesFrom    PlanChange[]       @relation("PlanChangeFrom")
  changesTo      PlanChange[]       @relation("PlanChangeTo")

  @@index([merchantId, status])
  @@map("subscription_plans")
}

model Subscription {
  id                 String              @id @default(cuid())
  merchantId         String
  customerUserId     String
  planId             String
  pricingSnapshot    Json
  frequency          BillingFrequency
  intervalCount      Int
  status             SubscriptionStatus  @default(PENDING)
  timezone           String              @default("Asia/Kolkata") @db.VarChar(64)
  startDate          DateTime
  trialEndDate       DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  nextBillingDate    DateTime?
  cancelledAt        DateTime?
  cancellationReason String?             @db.VarChar(500)
  cancellationTiming CancellationTiming?
  occurrenceCount    Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  merchant    Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer    User                @relation("SubscriptionCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  events      SubscriptionEvent[]
  occurrences BillingOccurrence[]
  invoices    Invoice[]
  changes     PlanChange[]

  @@index([merchantId, status])
  @@index([customerUserId, status])
  @@index([nextBillingDate, status])
  @@map("subscriptions")
}

model SubscriptionEvent {
  id             String   @id @default(cuid())
  subscriptionId String
  merchantId     String
  event          String   @db.VarChar(60)
  actor          String   @db.VarChar(80)
  metadata       Json?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  merchant     Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("subscription_events")
}

model BillingOccurrence {
  id                    String                  @id @default(cuid())
  subscriptionId        String
  merchantId            String
  occurrenceNumber      Int
  periodStart           DateTime
  periodEnd             DateTime
  amountMinor           Int
  currency              String                  @db.VarChar(3)
  status                BillingOccurrenceStatus @default(PENDING)
  idempotencyKey        String                  @unique @db.VarChar(120)
  paymentIntentId       String?                 @db.VarChar(80)
  paymentRef            String?                 @db.VarChar(80)
  invoiceId             String?
  attemptCount          Int                     @default(0)
  lastErrorCode         String?                 @db.VarChar(80)
  failureCategory       String?                 @db.VarChar(60)
  nextAttemptAt         DateTime?
  leaseUntil            DateTime?
  availableAt           DateTime                @default(now())
  resolvedAt            DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  merchant     Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, occurrenceNumber])
  @@index([status, availableAt])
  @@index([merchantId, status])
  @@map("billing_occurrences")
}

model Invoice {
  id             String        @id @default(cuid())
  merchantId     String
  customerUserId String
  subscriptionId String?
  occurrenceId   String?
  invoiceNumber  String        @db.VarChar(40)
  status         InvoiceStatus @default(DRAFT)
  subtotalMinor  Int
  taxMinor       Int           @default(0)
  discountMinor  Int           @default(0)
  setupFeeMinor  Int           @default(0)
  totalMinor     Int
  currency       String        @db.VarChar(3)
  issueDate      DateTime
  dueDate        DateTime
  periodStart    DateTime?
  periodEnd      DateTime?
  paymentRef     String?       @db.VarChar(80)
  customerName   String        @db.VarChar(120)
  customerEmail  String        @db.VarChar(254)
  voidedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  merchant    Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer    User                @relation("InvoiceCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  subscription Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  items       InvoiceLineItem[]

  @@unique([merchantId, invoiceNumber])
  @@index([merchantId, status, issueDate])
  @@index([customerUserId, issueDate])
  @@map("invoices")
}

model InvoiceLineItem {
  id             String @id @default(cuid())
  invoiceId      String
  description    String @db.VarChar(200)
  quantity       Int    @default(1)
  unitPriceMinor Int
  lineTotalMinor Int

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model InvoiceNumberSequence {
  merchantId String @id
  year       Int
  nextValue  Int    @default(1)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("invoice_number_sequences")
}

model PlanChange {
  id              String   @id @default(cuid())
  subscriptionId  String
  merchantId      String
  fromPlanId      String
  toPlanId        String
  reason          String?  @db.VarChar(500)
  effectiveDate   DateTime
  pricingSnapshot Json
  actor           String   @db.VarChar(80)
  createdAt       DateTime @default(now())

  subscription Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  merchant     Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  fromPlan     SubscriptionPlan @relation("PlanChangeFrom", fields: [fromPlanId], references: [id], onDelete: Restrict)
  toPlan       SubscriptionPlan @relation("PlanChangeTo", fields: [toPlanId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, createdAt])
  @@map("plan_changes")
}

model Statement {
  id          String          @id @default(cuid())
  userId      String
  periodStart DateTime
  periodEnd   DateTime
  format      StatementFormat
  status      StatementStatus @default(GENERATING)
  fileName    String?         @db.VarChar(200)
  fileSize    Int?
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("statements")
}
