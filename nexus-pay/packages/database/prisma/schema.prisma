generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum WalletStatus {
  PENDING
  PROVISIONING
  ACTIVE
  FAILED
  RECONCILIATION_REQUIRED
}

enum WalletType {
  CUSTOMER
}

model User {
  id                    String   @id @default(cuid())
  fullName              String   @db.VarChar(120)
  email                 String   @unique @db.VarChar(254)
  phoneNumber           String   @unique @db.VarChar(20)
  passwordHash          String
  username              String   @unique @db.VarChar(30)
  isEmailVerified       Boolean  @default(false)
  isPhoneVerified       Boolean  @default(false)
  accountStatus         AccountStatus @default(ACTIVE)
  emailVerifiedAt       DateTime?
  phoneVerifiedAt       DateTime?
  lastLoginAt           DateTime?
  onboardingCompletedAt DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  profile             UserProfile?
  sessions            UserSession[]
  wallets             Wallet[]
  passwordResetTokens PasswordResetToken[]
  auditEvents         AuditEvent[]         @relation("ActorAuditEvents")

  @@index([accountStatus])
  @@index([createdAt])
  @@map("users")
}

model UserProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  displayName       String   @db.VarChar(60)
  avatarUrl         String?  @db.VarChar(2048)
  preferredCurrency String   @default("INR") @db.VarChar(3)
  preferredLanguage String   @default("en-IN") @db.VarChar(10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  sessionTokenHash String    @unique @db.VarChar(64)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  ipAddress        String?   @db.VarChar(64)
  userAgent        String?   @db.VarChar(512)
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Wallet {
  id                    String       @id @default(cuid())
  userId                String
  raftlineAccountId     String?      @unique @db.VarChar(80)
  currency              String       @default("INR") @db.VarChar(3)
  walletType            WalletType   @default(CUSTOMER)
  status                WalletStatus @default(PENDING)
  provisioningAttempts  Int          @default(0)
  lastProvisioningError String?      @db.Text
  provisionedAt         DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency])
  @@index([status])
  @@map("wallets")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(60)
  entityId   String   @db.VarChar(80)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  actor User? @relation("ActorAuditEvents", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}
