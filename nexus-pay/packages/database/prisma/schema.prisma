// ---------------------------------------------------------------------------
// Release 11 — Credit marketplace & loan management.
// Nexus Pay is a discovery/workflow platform, never the lender. All loan state
// follows verified provider evidence; no wallet is debited for repayments.
// ---------------------------------------------------------------------------

enum LendingProviderMode {
  SANDBOX
  PRODUCTION
}

enum CreditProductType {
  PERSONAL
  CONSUMER_DURABLE
  EDUCATION
  VEHICLE
  BUSINESS
  SECURED
  CREDIT_LINE
  OTHER
}

enum InterestRateType {
  REDUCING_BALANCE
  FLAT
  VARIABLE
  PROVIDER_DEFINED
}

enum LoanApplicationStatus {
  DRAFT
  READY_FOR_SUBMISSION
  SUBMITTED
  ACKNOWLEDGED
  UNDER_REVIEW
  ADDITIONAL_INFORMATION_REQUIRED
  APPROVED
  REJECTED
  OFFERED
  ACCEPTED
  DISBURSEMENT_PENDING
  DISBURSED
  WITHDRAWN
  EXPIRED
  CANCELLED
}

enum EligibilityOutcome {
  PRE_ASSESSMENT_ONLY
  PROVIDER_ELIGIBLE
  PROVIDER_INELIGIBLE
  INSUFFICIENT_DATA
}

enum LoanDocumentStatus {
  UPLOADING
  READY
  FAILED
  DELETED
}

enum LoanStatus {
  ACTIVE
  CLOSED
  REQUIRES_RECONCILIATION
}

enum LoanRepaymentStatus {
  UPCOMING
  DUE
  PROCESSING
  PAID
  OVERDUE
  FAILED
  WAIVED
  UNKNOWN
  REQUIRES_RECONCILIATION
}

enum LenderEventStatus {
  RECEIVED
  PROCESSED
  REPLAYED
  FAILED
}

model LendingProvider {
  id           String              @id @default(cuid())
  code         String              @unique @db.VarChar(60)
  displayName  String              @db.VarChar(160)
  mode         LendingProviderMode @default(SANDBOX)
  capabilities Json
  status       String              @db.VarChar(30) @default("UNAVAILABLE")
  config       Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  capabilitiesRows LendingProviderCapability[]
  products    CreditProduct[]
  offers      CreditOffer[]
  applications LoanApplication[]
  loans       ActiveLoan[]
  webhookEvents LenderWebhookEvent[]
  syncJobs    ProviderSyncJob[]
  servicingEvents LoanServicingEvent[]

  @@map("lending_providers")
}

model LendingProviderCapability {
  id         String   @id @default(cuid())
  providerId String
  capability String   @db.VarChar(60)
  enabled    Boolean  @default(false)

  provider LendingProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, capability])
  @@map("lending_provider_capabilities")
}

model CreditProduct {
  id                  String            @id @default(cuid())
  providerId          String
  code                String            @unique @db.VarChar(80)
  name                String            @db.VarChar(160)
  type                CreditProductType
  minAmountMinor      Int
  maxAmountMinor      Int
  interestRateBps     Int
  interestRateType    InterestRateType  @default(REDUCING_BALANCE)
  aprBps              Int?
  minTenureMonths     Int
  maxTenureMonths     Int
  processingFeeMinor  Int               @default(0)
  processingFeeBps    Int               @default(0)
  otherChargesMinor   Int               @default(0)
  repaymentFrequency  String            @db.VarChar(30) @default("MONTHLY")
  eligibilityCriteria Json?
  prepaymentTerms     String?           @db.VarChar(1000)
  latePaymentTerms    String?           @db.VarChar(1000)
  requiredDocuments   String[]
