  GROUP_CREATED
  GROUP_UPDATED
  MEMBER_JOINED
  MEMBER_REMOVED
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  SETTLEMENT_RECORDED
