// ---------------------------------------------------------------------------
// Release 10 — Unified financial hub & external account aggregation.
// External balances/transactions are reported, read-only provider data.
// Raftline remains authoritative for Nexus Pay wallet money.
// ---------------------------------------------------------------------------

enum ExternalProviderMode {
  SANDBOX
  PRODUCTION
}

enum ExternalAccountType {
  NEXUS_WALLET
  SAVINGS
  CURRENT
  FIXED_DEPOSIT
  RECURRING_DEPOSIT
  CREDIT_CARD
  LOAN
  OTHER
}

enum ExternalConnectionStatus {
  NOT_CONNECTED
  INITIATING
  AWAITING_USER_AUTHORIZATION
  AUTHORIZED
  SYNC_PENDING
  ACTIVE
  PARTIALLY_CONNECTED
  EXPIRED
  REVOKED
  FAILED
  REQUIRES_ATTENTION
}

enum ExternalConsentStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
  REJECTED
}

enum SyncJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum ProviderCallbackStatus {
  RECEIVED
  PROCESSED
  REPLAYED
  FAILED
}

enum DedupDecision {
  DUPLICATE
  DISTINCT
  UNREVIEWED
}

enum InternalTransferStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
}

model ExternalFinancialProvider {
  id           String              @id @default(cuid())
  code         String              @unique @db.VarChar(60)
  displayName  String              @db.VarChar(120)
  mode         ExternalProviderMode @default(SANDBOX)
  capabilities Json
  status       String              @db.VarChar(30) @default("AVAILABLE")
  config       Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  connections ExternalAccountConnection[]
  health      ProviderHealthSnapshot[]
  callbacks   ProviderCallbackEvent[]

  @@map("external_financial_providers")
}

model ExternalAccountConnection {
  id                    String                  @id @default(cuid())
  userId                String
  providerId            String
  status                ExternalConnectionStatus @default(INITIATING)
  providerConnectionRef String?                 @db.VarChar(160)
  callbackStateHash     String?                 @db.VarChar(64)
  stateExpiresAt        DateTime?
  lastSyncAt            DateTime?
  lastError             String?                 @db.VarChar(500)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  provider ExternalFinancialProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  accounts ExternalFinancialAccount[]
  consents ExternalAccountConsent[]
  jobs     AccountSyncJob[]
  checkpoints AccountSyncCheckpoint[]

  @@unique([providerId, providerConnectionRef])
  @@index([userId, status])
  @@map("external_account_connections")
}

model ExternalAccountConsent {
  id                   String                @id @default(cuid())
  connectionId         String
  userId               String
  providerConsentRef   String?               @db.VarChar(160)
  status               ExternalConsentStatus @default(PENDING)
  purpose              String                @db.VarChar(300)
  dataCategories       String[]
  periodFrom           DateTime
  periodTo             DateTime
  durationDays         Int                   @default(90)
  refreshFrequencyMinutes Int               @default(360)
  termsVersion         String                @db.VarChar(40)
  createdAt            DateTime              @default(now())
  expiresAt            DateTime
  revokedAt            DateTime?

  connection ExternalAccountConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  events     ConsentEvent[]

  @@index([userId, status])
  @@map("external_account_consents")
}

model ConsentEvent {
  id        String   @id @default(cuid())
  consentId String
  event     String   @db.VarChar(60)
  actor     String   @db.VarChar(80)
  metadata  Json?
  createdAt DateTime @default(now())

  consent ExternalAccountConsent @relation(fields: [consentId], references: [id], onDelete: Cascade)

  @@index([consentId, createdAt])
  @@map("consent_events")
}

model ExternalFinancialAccount {
  id                  String             @id @default(cuid())
  connectionId        String
  userId              String
  providerAccountRef  String             @db.VarChar(160)
  accountType         ExternalAccountType
  institutionName     String             @db.VarChar(160)
  maskedIdentifier    String             @db.VarChar(40)
  encryptedAccountRef String             @db.VarChar(512)
  currency            String             @db.VarChar(3)
  status              String             @db.VarChar(30) @default("ACTIVE")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  connection   ExternalAccountConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  balances     ExternalAccountBalanceSnapshot[]
  transactions ExternalTransaction[]
  checkpoints  AccountSyncCheckpoint[]

  @@unique([connectionId, providerAccountRef])
  @@index([userId, accountType])
  @@map("external_financial_accounts")
}

model ExternalAccountBalanceSnapshot {
  id                   String   @id @default(cuid())
  accountId            String
  reportedBalanceMinor BigInt
  availableBalanceMinor BigInt?
  currency             String   @db.VarChar(3)
  providerReportedAt   DateTime
