// ---------------------------------------------------------------------------
// Release 16 — Investments, portfolio & wealth.
// Holdings are external provider snapshots, never wallet transactions.
// Raftline remains authoritative for wallet money. No investment advice,
// order execution or fabricated provider data.
// ---------------------------------------------------------------------------

enum InvestmentProviderMode {
