  @@index([userId, status])
  @@map("recurring_bills")
}

model BillReminder {
  id          String            @id @default(cuid())
  userId      String            @db.VarChar(80)
  accountId   String?           @db.VarChar(80)
  billerId    String
  kind        String            @db.VarChar(40)
  dueAt       DateTime
  status      BillReminderStatus @default(PENDING)
  sentAt      DateTime?
  createdAt   DateTime          @default(now())
  @@unique([userId, accountId, kind, dueAt])
  @@index([status, dueAt])
  @@map("bill_reminders")
}

model BillAutoPaymentAuthorization {
  id              String              @id @default(cuid())
  userId          String              @db.VarChar(80)
  accountId       String              @db.VarChar(80)
  recurringBillId String?             @db.VarChar(80)
  maxAmountMinor  Int
  frequency       String              @db.VarChar(30)
  status          BillAutoPaymentStatus @default(ACTIVE)
  nextExecutionAt DateTime?
  authorizedAt    DateTime            @default(now())
