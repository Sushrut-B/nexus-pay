  version     String   @db.VarChar(80)
  payload     Json
  retrievedAt DateTime @default(now())
  biller Biller @relation(fields: [billerId], references: [id], onDelete: Cascade)
  @@unique([billerId, version])
  @@map("biller_catalogue_versions")
}

model SavedBillerAccount {
  id              String      @id @default(cuid())
  userId          String      @db.VarChar(80)
  billerId        String
  nickname        String      @db.VarChar(120)
  parameters      Json        @default("{}")
  maskedIdentifier String     @db.VarChar(80)
  lastFetchAt     DateTime?
  lastPaymentAt   DateTime?
  status          String      @db.VarChar(20) @default("ACTIVE")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  biller Biller @relation(fields: [billerId], references: [id], onDelete: Cascade)
  payments BillPaymentIntent[]
  @@index([userId, status])
  @@map("saved_biller_accounts")
}

model BillFetchRequest {
