  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  @@index([userId, status])
  @@map("bill_auto_payment_authorizations")
}

model BillReconciliationCase {
  id                String                  @id @default(cuid())
  reference         String                  @unique @db.VarChar(120)
  paymentId         String?                 @db.VarChar(80)
  rechargeId        String?                 @db.VarChar(80)
  userId            String?                 @db.VarChar(80)
  reason            String                  @db.VarChar(120)
  status            BillReconciliationStatus @default(OPEN)
  assignedTo        String?                 @db.VarChar(120)
  resolution        String?                 @db.VarChar(1000)
  createdAt         DateTime                @default(now())
  resolvedAt        DateTime?
  @@index([status, createdAt])
  @@map("bill_reconciliation_cases")
}

model Household {
