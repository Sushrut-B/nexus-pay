  allocatedMinor Int      @default(0)
  reservedMinor  Int      @default(0)
  consumedMinor  Int      @default(0)
  pointsAllocated Int     @default(0)
  pointsReserved Int      @default(0)
  pointsConsumed Int      @default(0)
  updatedAt      DateTime @updatedAt

